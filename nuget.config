<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--Freshly packed bindings land here (dotnet pack ... -o local-nuget) so the wrapper, demo and tests can
    restore a version that is not on nuget.org yet. The folder is committed empty and its contents ignored.-->
    <add key="local" value="./local-nuget" />
  </packageSources>
  <packageSourceMapping>
    <!--The binding family is mapped to BOTH sources on purpose. Source mapping searches only the sources that
    share the most specific matching pattern, so mapping the family to `local` alone would make a machine with
    an empty local-nuget (every CI runner) unable to restore the published bindings from nuget.org.-->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Kebechet.Maui.Facebook.Core.*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="Kebechet.Maui.Facebook.Core.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
