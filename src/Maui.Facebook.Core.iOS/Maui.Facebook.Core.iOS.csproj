<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <!--FBSDKCoreKit.framework/Info.plist declares MinimumOSVersion 12.0; 12.2 is the floor the .NET iOS SDK accepts.-->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Label="NugetProperties">
    <Authors>Kebechet</Authors>
    <IsPackable>true</IsPackable>
    <PackageId>Kebechet.Maui.Facebook.Core.iOS</PackageId>
    <Description>Contains bindings for FBSDKCoreKit from https://github.com/facebook/facebook-ios-sdk (App Events, Settings, ApplicationDelegate)</Description>
    <RepositoryUrl>https://github.com/Kebechet/Maui.Facebook.Core/tree/main/src/Maui.Facebook.Core.iOS</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Kebechet/Maui.Facebook.Core/tree/main/src/Maui.Facebook.Core.iOS</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>icon.png</PackageIcon>
    <Version>19.0.0.0</Version>
    <PackageReleaseNotes>19.0.0.0: bumped native Facebook iOS SDK from 18.1.1 to 19.0.0. Upstream: Added: Starting on 10/31/2026, Screen Title and AppLink URL will be included with events logged with Facebook SDK. You can disable additional metadata by setting FBSDKAutoLogMetaDataEnabled false in your Info.plist or by turning off "Automatically include more app event details" in Events Manager. FB SDK will automatically send sampled information about your app, such as the layout of elements on app screens. This information helps Meta improve ads systems and build new features. It is not used for ads delivery. You can disable the feature by setting the FBSDKAutoLogProductImprovementEnabled false in your Info.plist or by turning off "Automatically send more app information" in Events Manager. Changed: If the FacebookAutoLogAppEventsEnabled flag is set as false, Automatic App Event Logging will be disabled even if it is enabled in Events Manager. Breaking: the minimum supported deployment target is now iOS 15.0 (was iOS 12.0). Xcode 27 does not support deployment targets below iOS 15.0. Apps still targeting iOS 12–14 must raise their deployment target to adopt this version. FBSDKCoreKit no longer declares import AdSupport in its generated Swift interface. The last Swift use of ASIdentifierManager was a pre-ATT fallback that the iOS 15 floor made unreachable, and it has been removed. AdSupport is still linked by FBSDKCoreKit and still used from Objective-C, and no public symbol changed, so this affects only the interface file. Swift code that relies on ASIdentifierManager should import AdSupport directly rather than depending on it transitively. Fixed: Limited Login Refresh: automatic foreground refresh now resumes for a session restored after the app is relaunched, and after logging out and back in during the same app session. The time of the last automatic refresh is now persisted, so limitedLoginAutoRefreshInterval also applies across launches. BREAKING: the minimum supported iOS version is now 15.0 (was 12.2), as required by the native SDK. Changelog: https://github.com/facebook/facebook-ios-sdk/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
  </ItemGroup>

  <!--Three frameworks, one package: FBSDKCoreKit links FBSDKCoreKit_Basics and FBAEMKit at load time,
  so an app that embeds only the first crashes on launch with an image-not-found. All three are the
  Dynamic_XCFramework release assets of the same SDK version, with the maccatalyst slice, .swiftmodule
  and .dSYM directories removed (Catalyst is a no-op stub in the wrapper; the other two are debug-only
  and ~150 MB).-->
  <ItemGroup>
    <NativeReference Include="nativelib\FBSDKCoreKit.xcframework">
      <Kind>Framework</Kind>
      <Frameworks>Foundation UIKit Security CoreGraphics WebKit Accelerate CoreTelephony SafariServices AdSupport</Frameworks>
      <WeakFrameworks>AppTrackingTransparency StoreKit</WeakFrameworks>
      <ForceLoad>True</ForceLoad>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Include="nativelib\FBSDKCoreKit_Basics.xcframework">
      <Kind>Framework</Kind>
      <Frameworks>Foundation</Frameworks>
      <ForceLoad>True</ForceLoad>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Include="nativelib\FBAEMKit.xcframework">
      <Kind>Framework</Kind>
      <Frameworks>Foundation</Frameworks>
      <ForceLoad>True</ForceLoad>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

</Project>
